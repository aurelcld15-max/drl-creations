# =============================================================================
# DRL CRÉATIONS — FICHIER DE CONFIGURATION D'ENVIRONNEMENT (.env.example)
# Copiez ce fichier en ".env" à la racine du projet et renseignez vos accès.
# =============================================================================

APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost/DRL-CREATIONS
APP_NAME="DRL CRÉATIONS"
APP_TIMEZONE="Africa/Porto-Novo"

# Base de données principale : PostgreSQL Supabase
DB_DRIVER=pgsql
DB_HOST=db.<project-ref>.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_SSLMODE=require

# Pour Supabase : copiez les paramètres PostgreSQL du bouton « Connect »
# du projet (direct ou pooler de session), puis utilisez DB_DRIVER=pgsql.
# Ne placez jamais ces valeurs dans le code ou dans le navigateur.
SUPABASE_URL=https://bcdsbailkdcspgukqisd.supabase.co
SUPABASE_ANON_KEY=sb_publishable_iQXWfIbqrpbF4RotYAazMg_nNAPDaed
SUPABASE_STORAGE_BUCKET=drl-media

# Source MySQL à utiliser uniquement pour database/migrate_mysql_to_supabase.php
MYSQL_SOURCE_HOST=127.0.0.1
MYSQL_SOURCE_PORT=3306
MYSQL_SOURCE_DB=drl_creations
MYSQL_SOURCE_USER=root
MYSQL_SOURCE_PASSWORD=

# API Intelligence Artificielle (Optionnel : OpenAI / Gemini pour enrichir le moteur SQL natif)
AI_PROVIDER=native_hybrid
AI_API_KEY=AIzaSyAiT0rA7S98DIHEqHigBsvJ96FL31EJCzQ
AI_MODEL=gpt-4o-mini
