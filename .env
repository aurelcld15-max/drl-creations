# =============================================================================
# DRL CRÉATIONS — Configuration d'environnement
# Ce fichier est lu par l'application (config/app.php) à la racine du projet.
# ATTENTION : il contient des secrets. Ne le publiez pas sur un dépôt public.
# =============================================================================

APP_ENV=production
APP_DEBUG=false
APP_URL=https://drl-creations.vercel.app
APP_NAME="DRL CRÉATIONS"
APP_TIMEZONE="Africa/Porto-Novo"

# Sessions stockées dans PostgreSQL (obligatoire en serverless / Vercel).
# En local XAMPP, vous pouvez mettre "file".
SESSION_DRIVER=db

# Base de données principale : PostgreSQL Supabase (Session pooler, port 5432)
DB_DRIVER=pgsql
DB_HOST=aws-0-eu-west-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.bcdsbailkdcspgukqisd
DB_PASSWORD=
DB_SSLMODE=require

# Supabase Auth & Storage (clé publishable uniquement, jamais la clé secret)
SUPABASE_URL=https://bcdsbailkdcspgukqisd.supabase.co
SUPABASE_ANON_KEY=sb_publishable_iQXWfIbqrpbF4RotYAazMg_nNAPDaed
SUPABASE_STORAGE_BUCKET=drl-media

# Source MySQL à utiliser uniquement pour database/migrate_mysql_to_supabase.php
MYSQL_SOURCE_HOST=127.0.0.1
MYSQL_SOURCE_PORT=3306
MYSQL_SOURCE_DB=drl_creations
MYSQL_SOURCE_USER=root
MYSQL_SOURCE_PASSWORD=

# API Intelligence Artificielle (optionnel)
AI_PROVIDER=native_hybrid
AI_API_KEY=AIzaSyAiT0rA7S98DIHEqHigBsvJ96FL31EJCzQ
AI_MODEL=gpt-4o-mini
