# =============================================================================
# DRL CRÉATIONS — FICHIER DE CONFIGURATION D'ENVIRONNEMENT (.env.example)
# Copiez ce fichier en ".env" à la racine du projet et renseignez vos accès.
# =============================================================================

APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost/DRL-CREATIONS
APP_NAME="DRL CRÉATIONS"
APP_TIMEZONE="Africa/Porto-Novo"

# Configuration Base de Données MySQL 8+
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=drl_creations
DB_USER=root
DB_PASS=

# Configuration SMTP / Envoi d'e-mails de confirmation
MAIL_FROM_ADDRESS=no-reply@drl-creations.com
MAIL_FROM_NAME="Maison DRL CRÉATIONS"
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# OAuth 2.0 / OpenID Connect — Google Sign-In
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost/DRL-CREATIONS/auth/oauth/callback.php?provider=google

# OAuth 2.0 / OpenID Connect — Sign in with Apple
APPLE_CLIENT_ID=com.drlcreations.web
APPLE_TEAM_ID=YOUR_APPLE_TEAM_ID
APPLE_KEY_ID=YOUR_APPLE_KEY_ID
APPLE_PRIVATE_KEY_PATH=config/apple_auth_key.p8
APPLE_REDIRECT_URI=http://localhost/DRL-CREATIONS/auth/oauth/callback.php?provider=apple

# API Intelligence Artificielle (Optionnel : OpenAI / Gemini pour enrichir le moteur SQL natif)
AI_PROVIDER=native_hybrid
AI_API_KEY=
AI_MODEL=gpt-4o-mini
